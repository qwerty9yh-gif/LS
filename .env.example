PORT=4173

# PostgreSQL connection string — required for PostgreSQL storage.
# Use the transaction-mode pooler for the application.
DATABASE_URL=

# Use the session-mode (direct) pooler for migrations and schema setup.
DIRECT_URL=

# Comma-separated list of browser origins allowed to call this API (CORS).
# The GitHub Pages frontend origin must be listed here.
ALLOWED_ORIGINS=https://qwerty9yh-gif.github.io,http://localhost:4173

# Single universal login account (optional overrides for npm run seed:user).
# Defaults: qwerty@gmail.com / 123456789. The password is stored as a
# scrypt hash in the users table — never in plain text.
UNIVERSAL_EMAIL=qwerty@gmail.com
UNIVERSAL_PASSWORD=123456789

# Optional fixed company details for invoice printing. Physical letterhead
# remains the source for the printed logo and fixed top/footer branding.
LAUNDRY_COMPANY_NAME=
LAUNDRY_COMPANY_PO_BOX=
LAUNDRY_COMPANY_ADDRESS=
LAUNDRY_COMPANY_PHONE=
LAUNDRY_COMPANY_EMAIL=
