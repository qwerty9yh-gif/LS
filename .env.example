PORT=4173

# Optional Google Sheets API integration.
# Keep these values on the server only. Never put them in public/*.js.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Preferred local setup: put the downloaded service-account JSON beside the server
# and point to it here. Do not commit the JSON file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=ls-sheet-508920-76865e6ba949.json

# Alternative setup for hosted servers:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Optional: if your sheet uses a different tab name.
GOOGLE_SHEETS_TAB=Records
