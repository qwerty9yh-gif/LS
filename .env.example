PORT=4173

# PostgreSQL connection string — required for PostgreSQL storage.
# Use the transaction-mode pooler for the application.
DATABASE_URL=

# Use the session-mode (direct) pooler for migrations and schema setup.
DIRECT_URL=

# Comma-separated list of browser origins allowed to call this API (CORS).
# The GitHub Pages frontend origin must be listed here.
ALLOWED_ORIGINS=https://qwerty9yh-gif.github.io,http://localhost:4173

# Single universal login account (optional overrides for npm run seed:user).
# Defaults: 47year@gmail.com / 123456789. The password is stored as a
# scrypt hash in the users table — never in plain text.
UNIVERSAL_EMAIL=47year@gmail.com
UNIVERSAL_PASSWORD=123456789

# ─── Optional Google Sheets API integration (legacy sync target) ──────────
# PostgreSQL is now the primary data store. Google Sheets sync remains as an
# optional export feature. Keep credentials on the server only.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Preferred local setup: put the downloaded service-account JSON beside the server
# and point to it here. Do not commit the JSON file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=ls-sheet-508920-76865e6ba949.json

# Alternative setup for hosted servers:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Optional: if your sheet uses a different tab name.
GOOGLE_SHEETS_TAB=Records
