generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Shift {
  morning
  afternoon
  evening
  night

  @@map("shift_type")
}

enum RecordStatus {
  received
  pending
  dispatched

  @@map("record_status")
}

enum SyncStatus {
  synced
  pending

  @@map("sync_status")
}

model Record {
  id               String       @id
  date             DateTime     @db.Date
  shift            Shift
  material         String       @default("")
  color            String       @default("")
  rowKey           String       @default("") @map("row_key")
  quantity         Int?         @default(0)
  laundryPersonnel String       @default("") @map("laundry_personnel")
  verifiedBy       String       @default("") @map("verified_by")
  signature        String       @default("")
  status           RecordStatus @default(received)
  syncStatus       SyncStatus   @default(pending) @map("sync_status")
  syncError        String       @default("") @map("sync_error")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  syncedAt         DateTime?    @map("synced_at") @db.Timestamptz(6)

  @@index([date], map: "idx_records_date")
  @@index([shift], map: "idx_records_shift")
  @@index([date, shift], map: "idx_records_date_shift")
  @@index([date, material, color], map: "idx_records_monthly")
  @@index([syncStatus], map: "idx_records_sync_status")
  @@index([status], map: "idx_records_status")
  @@map("records")
}

model Lock {
  id       Int      @id @default(autoincrement())
  date     DateTime @db.Date
  shift    Shift
  lockedAt DateTime @default(now()) @map("locked_at") @db.Timestamptz(6)
  reason   String   @default("Shift closed")

  @@unique([date, shift])
  @@index([date, shift], map: "idx_locks_date_shift")
  @@map("locks")
}

model DailyForm {
  date      DateTime @id @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("daily_forms")
}

model ShiftOrder {
  shift        Shift    @id
  displayOrder Int      @map("display_order")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([displayOrder], map: "idx_shift_orders_display_order")
  @@map("shift_orders")
}

model MaterialColor {
  id           Int      @id @default(autoincrement())
  material     String
  label        String
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([material, label], map: "material_colors_material_label_key")
  @@index([material, displayOrder], map: "idx_material_colors_material_order")
  @@map("material_colors")
}

model UnitPrice {
  material  String
  color     String
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([material, color])
  @@map("unit_prices")
}

model InvoiceSequence {
  month      String   @id
  lastNumber Int      @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("invoice_sequences")
}

model Invoice {
  invoiceNumber String   @id @map("invoice_number")
  month         String
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)
  billTo        Json     @map("bill_to")
  companyInfo   Json     @map("company_info")
  lineItems     Json     @map("line_items")
  grandTotal    String   @map("grand_total")
  topSafeMm     Int      @map("top_safe_mm")
  bottomSafeMm  Int      @map("bottom_safe_mm")

  @@index([month, generatedAt(sort: Desc)], map: "idx_invoices_month_generated")
  @@map("invoices")
}

model SyncEvent {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now()) @db.Timestamptz(6)
  status String
  error  String?
  detail Json?

  @@index([at(sort: Desc)], map: "idx_sync_events_at")
  @@map("sync_events")
}

model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  @@index([email], map: "idx_users_email")
  @@map("users")
}